{
  "mcpServers": {
    "Roblox_Studio": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/c",
        "cd /d %LOCALAPPDATA%\\Roblox && .\\mcp.bat"
      ],
      "env": {}
    },
    "blender": {
      "type": "stdio",
      "command": "${USERPROFILE}\\.local\\bin\\uvx.exe",
      "args": ["--python", "3.11", "mcp-for-blender"],
      "env": {}
    }
  }
}
